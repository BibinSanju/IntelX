# Copy to backend/.env for local development only. Never commit real keys.
DATABASE_URL=postgresql://user:password@localhost:5432/placement_portal
DIRECT_URL=postgresql://user:password@localhost:5432/placement_portal

# JSON arrays, or comma/newline/semicolon-separated values.
GOOGLE_API_KEYS=["replace-with-authorized-google-key-1","replace-with-authorized-google-key-2"]
GROQ_API_KEYS=["replace-with-authorized-groq-key-1","replace-with-authorized-groq-key-2"]

# This project is configured for one key per independent Google project.
# Change to shared if any keys belong to the same project.
GOOGLE_QUOTA_SCOPE=per-project

# One personal Groq key per independent personal organization.
# Change to shared if any keys belong to the same Groq account/organization.
GROQ_QUOTA_SCOPE=per-organization

GEMINI_MODEL=gemini-3.8-flash
SCREENSHOT_GEMINI_MODEL=gemini-3.8-flash
SCREENSHOT_GEMINI_TIMEOUT_MS=60000
GROQ_MODEL=openai/gpt-oss-120b

# Conservative free-tier profile with roughly 10% safety headroom.
# Verify the active Gemini 3.8 Flash values in AI Studio periodically.
GOOGLE_RPM=4
GOOGLE_TPM=225000
GOOGLE_RPD=18
GOOGLE_TPD=0
GOOGLE_CONCURRENCY=1

# Defaults include safety headroom below the published gpt-oss-120b free limits.
GROQ_RPM=27
GROQ_RPD=900
GROQ_TPM=7200
GROQ_TPD=180000
GROQ_CONCURRENCY=1

GROQ_AUDIO_RPM=18
GROQ_AUDIO_RPD=1800
GROQ_AUDIO_CONCURRENCY=1

# Google can try each of the 20 independent project credentials once.
GOOGLE_MAX_ATTEMPTS=20
# Try each of the 20 independent personal Groq organizations once.
GROQ_MAX_ATTEMPTS=20
PROVIDER_MAX_QUEUE_WAIT_MS=120000
PROVIDER_BASE_COOLDOWN_MS=2000

# Reddit's API currently requires explicit approval and OAuth credentials.
# Keep this false until Reddit approves the application for this use case.
REDDIT_API_APPROVED=false
REDDIT_CLIENT_ID=replace-with-approved-reddit-client-id
REDDIT_CLIENT_SECRET=replace-with-approved-reddit-client-secret
REDDIT_USER_AGENT=web:placement-question-curator:1.0 (by /u/your-reddit-username)
REDDIT_SUBREDDITS=leetcode,cscareerquestions,developersIndia
REDDIT_SEARCH_QUERY="interview question" OR "asked in interview" OR "online assessment"
